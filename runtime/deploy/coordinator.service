[Unit]
Description=Autoresearch distributed POC coordinator
After=network.target

[Service]
Type=simple
ExecStart=/opt/autoresearch/venv/bin/autoresearch-dist --store /var/lib/autoresearch/coordinator --archive /var/lib/autoresearch/archive serve --bind 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
